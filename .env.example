# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site, no trailing slash (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SCHOOL_NAME=Our High School

# Resend (https://resend.com) for message notifications and claim codes
RESEND_API_KEY=re_your_key
EMAIL_FROM="Alumni Network <network@your-school-domain.org>"

# Comma-separated emails that get staff access when they sign in
STAFF_EMAILS=counselor@your-school-domain.org

# Random string used to hash claim verification codes (e.g. `openssl rand -hex 32`)
CLAIM_CODE_SECRET=change-me
